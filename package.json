{
  "name": "@finografic/lucide-manager",
  "type": "module",
  "version": "0.11.0",
  "private": false,
  "description": "Browse, select, and manage Lucide icons for your design system registry.",
  "homepage": "https://github.com/finografic/lucide-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finografic/lucide-manager.git"
  },
  "bugs": {
    "url": "https://github.com/finografic/lucide-manager/issues"
  },
  "author": {
    "name": "Justin Rankin",
    "email": "justin.blair.rankin@gmail.com",
    "url": "https://github.com/finografic"
  },
  "license": "MIT",
  "keywords": [
    "finografic",
    "lucide-manager",
    "genx:type:cli",
    "lucide",
    "icon-picker",
    "design-system"
  ],
  "files": [
    "bin",
    "src",
    "scripts",
    "public",
    "index.html",
    "icons.json",
    "lucide-manager.defaults.json",
    "lucide-manager.config.schema.json",
    "lucide-manager.config.example.json",
    "vite.config.ts"
  ],
  "bin": {
    "lucide-manager": "./bin/lucide-manager.js"
  },
  "scripts": {
    "---------- DEV": "-------------------------------------------------------",
    "dev": "vite",
    "·········· BUILD": "·····················································",
    "build": "vite build",
    "·········· TESTING": "···················································",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "·········· LINTING": "···················································",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "lint:ci": "oxlint -c oxlint.config.ts --quiet",
    "lint:md": "md-lint",
    "lint:md:fix": "md-lint --fix",
    "·········· FORMATTING": "·················································",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "·········· PUBLISH:GITHUB": "············································",
    "release:github:patch": "pnpm run release:check && pnpm version patch && git push --follow-tags",
    "release:github:minor": "pnpm run release:check && pnpm version minor && git push --follow-tags",
    "release:github:major": "pnpm run release:check && pnpm version major && git push --follow-tags",
    "release:check": "pnpm format:check && pnpm lint:fix && pnpm typecheck && pnpm test:run",
    "release:publish": "pnpm publish --registry https://npm.pkg.github.com",
    "view:registry:github": "pnpm view @finografic/lucide-manager --registry=https://npm.pkg.github.com",
    "·········· PACKAGES": "··················································",
    "update:oxc-config": "pnpm update @finografic/oxc-config --latest && pnpm update oxfmt --latest && pnpm update oxlint --latest",
    "upgrade:deps:all": "pnpm update --latest",
    "·········· UTILS": "·····················································",
    "tsc:debug": "tsc --pretty --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/roboto": "^5.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@finografic/lucide-manager": "link:",
    "@finografic/md-lint": "^0.16.4",
    "@finografic/oxc-config": "^2.6.6",
    "@finografic/project-scripts": "^1.3.3",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "24.12.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.10.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.1",
    "typescript": "6.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint -c oxlint.config.ts --fix --no-error-on-unmatched-pattern --ignore-pattern '_templates/package-types/**'"
    ],
    "*.md": [
      "oxfmt --no-error-on-unmatched-pattern",
      "md-lint --fix"
    ],
    "*.{json,jsonc,yml,yaml,toml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
